{
  "name": "security-alert-os",
  "version": "1.0.0",
  "description": "Security Alert OS - System Security Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.securityalertos.app",
    "productName": "Security Alert OS",
    "files": [
      "main.js",
      "src/**/*",
      "!src-tauri/**",
      "!marketing-page/**",
      "!.vscode/**",
      "!.github/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "src/images/icon.png",
      "artifactName": "Security-Alert-OS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Security Alert OS"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "src/images/icon.icns",
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "identity": null,
      "gatekeeperAssess": false,
      "artifactName": "Security.Alert.OS-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Security Alert OS",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/images/icon.png"
    }
  },
  "keywords": [
    "security",
    "alert",
    "electron"
  ],
  "author": "Security Alert OS",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
